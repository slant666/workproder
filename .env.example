WORK_ORDER_DB_NAME=work_order_system
WORK_ORDER_CONTAINER_DB_USERNAME=work_order_app
WORK_ORDER_CONTAINER_DB_PASSWORD=change-me-app-password
WORK_ORDER_CONTAINER_DB_ROOT_PASSWORD=change-me-root-password
WORK_ORDER_BOOTSTRAP_ADMIN_TOKEN=change-me-bootstrap-token
WORK_ORDER_HTTP_PORT=8088
WORK_ORDER_REDIS_TIMEOUT=2s
WORK_ORDER_RABBITMQ_ENABLED=true
WORK_ORDER_RABBITMQ_USERNAME=workorder
WORK_ORDER_RABBITMQ_PASSWORD=workorder
WORK_ORDER_ATTACHMENT_MAX_SIZE_BYTES=10485760
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your-sender@qq.com
SPRING_MAIL_PASSWORD=your-smtp-authorization-code
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
WORK_ORDER_EMAIL_FROM=your-sender@qq.com
WORK_ORDER_EMAIL_DELIVERY_ENABLED=false
